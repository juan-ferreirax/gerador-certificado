# Git ignore rules for this project.
# Reference: https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# Build artifacts / compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node dependencies and logs
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors (local workspace settings)
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/
.vscode/*
.history/*

# Angular cache
/.angular

# Miscellaneous caches and outputs
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db

# Obsidian workspace files
.obsidian
